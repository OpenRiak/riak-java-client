# Example Gradle properties for local development and automation tasks.
#
# Copy the properties you need into one of:
#   - ~/.gradle/gradle.properties  (recommended for credentials)
#   - ./gradle.properties          (do not commit real credential values)
#
# This file lists required property *names* only. Values below are placeholders.
# Obtain real credentials through your team's Artifactory, Bitbucket/Jira, and
# Slack access processes. Never commit live secrets to version control.

# -----------------------------------------------------------------------------
# Artifactory (required for ./gradlew publish)
# -----------------------------------------------------------------------------
artifactory_publish_codeline=trunk
artifactory_user=YOUR_ARTIFACTORY_USERNAME
artifactory_password=PLACEHOLDER_PASSWORD

# -----------------------------------------------------------------------------
# Bitbucket / Jira (lockfileUpdates and checkoutLockFilePr tasks)
# -----------------------------------------------------------------------------
atlassianUser=YOUR_ATLASSIAN_USERNAME
atlassianPassword=PLACEHOLDER_PASSWORD
jiraEpic=DOCSTOR-XXXX

# -----------------------------------------------------------------------------
# Slack (lockfile update notifications)
# -----------------------------------------------------------------------------
slackToken=xoxb-PLACEHOLDER-SLACK-BOT-TOKEN
slackChannel=#docstor-build

# -----------------------------------------------------------------------------
# PR build validator (CI injects these; not needed for normal local builds)
# -----------------------------------------------------------------------------
#validate=true
#buildUrl=https://ci.example.workday.com/job/example/1/
#buildStage=build
#repositoryRevision=abc123def456
#approveOrDeny=true
